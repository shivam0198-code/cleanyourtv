<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1022"
    android:padding="48dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#39C5CF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="24dp"
        android:layout_marginBottom="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#FF5555"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_stopped"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textWebUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web Browser: http://192.168.1.8:8080"
            android:textColor="#E0FFFFFF"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/textFtpUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FTP Address: ftp://192.168.1.8:2121"
            android:textColor="#E0FFFFFF"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Storage root: /sdcard (Games: /sdcard/Roms/NES) • Auto-stop after 20m idle"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:background="@drawable/btn_pill"
            android:textColor="@color/btn_text"
            android:text="@string/start_server"
            android:textSize="16sp"
            android:textStyle="bold"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

</LinearLayout>
