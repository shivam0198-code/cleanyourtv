<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- COMMAND CENTER VIEW -->
    <LinearLayout
        android:id="@+id/command_center_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOME CCTV"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/header_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="5 Feeds Online • 192.168.1.2"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Command Center Middle Section: Hero (Left) + 2x2 Grid (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- HERO CAMERA (Left 62%) -->
            <FrameLayout
                android:id="@+id/hero_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:layout_margin="4dp"
                android:background="@drawable/card_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@+id/grid_slot_0"
                android:nextFocusLeft="@+id/hero_card"
                android:nextFocusUp="@+id/hero_card"
                android:nextFocusDown="@+id/hero_card">

                <!-- Video View -->
                <TextureView
                    android:id="@+id/hero_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Snapshot Fallback -->
                <ImageView
                    android:id="@+id/hero_snapshot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Hero Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|left"
                    android:layout_margin="12dp"
                    android:background="@drawable/pill_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingTop="5dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/hero_live_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● LIVE"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hero_quality_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="HD"
                        android:textColor="@color/focus_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Camera 1"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fullscreen Hint pill inside hero -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:layout_margin="12dp"
                    android:background="@drawable/pill_badge"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="[OK] Full Screen"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- 2x2 SECONDARY CAMERAS (Right 38%) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="38"
                android:orientation="vertical">

                <!-- Row 1: Cam 2 & Cam 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Slot 0 -->
                    <FrameLayout
                        android:id="@+id/grid_slot_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/card_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/hero_card"
                        android:nextFocusRight="@+id/grid_slot_1"
                        android:nextFocusDown="@+id/grid_slot_2"
                        android:nextFocusUp="@+id/grid_slot_0">

                        <ImageView
                            android:id="@+id/grid_img_0"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/grid_title_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|left"
                            android:layout_margin="8dp"
                            android:background="@drawable/pill_badge"
                            android:paddingLeft="8dp"
                            android:paddingTop="3dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="3dp"
                            android:text="Camera 2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Slot 1 -->
                    <FrameLayout
                        android:id="@+id/grid_slot_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/card_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/grid_slot_0"
                        android:nextFocusRight="@+id/grid_slot_1"
                        android:nextFocusDown="@+id/grid_slot_3"
                        android:nextFocusUp="@+id/grid_slot_1">

                        <ImageView
                            android:id="@+id/grid_img_1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/grid_title_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|left"
                            android:layout_margin="8dp"
                            android:background="@drawable/pill_badge"
                            android:paddingLeft="8dp"
                            android:paddingTop="3dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="3dp"
                            android:text="Camera 3"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2: Cam 4 & Cam 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Slot 2 -->
                    <FrameLayout
                        android:id="@+id/grid_slot_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/card_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/hero_card"
                        android:nextFocusRight="@+id/grid_slot_3"
                        android:nextFocusUp="@+id/grid_slot_0"
                        android:nextFocusDown="@+id/grid_slot_2">

                        <ImageView
                            android:id="@+id/grid_img_2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/grid_title_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|left"
                            android:layout_margin="8dp"
                            android:background="@drawable/pill_badge"
                            android:paddingLeft="8dp"
                            android:paddingTop="3dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="3dp"
                            android:text="Camera 4"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Slot 3 -->
                    <FrameLayout
                        android:id="@+id/grid_slot_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/card_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/grid_slot_2"
                        android:nextFocusRight="@+id/grid_slot_3"
                        android:nextFocusUp="@+id/grid_slot_1"
                        android:nextFocusDown="@+id/grid_slot_3">

                        <ImageView
                            android:id="@+id/grid_img_3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/grid_title_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|left"
                            android:layout_margin="8dp"
                            android:background="@drawable/pill_badge"
                            android:paddingLeft="8dp"
                            android:paddingTop="3dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="3dp"
                            android:text="Camera 5"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Remote Hints Bar -->
        <TextView
            android:id="@+id/hint_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/hint_bar"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- FULLSCREEN OVERLAY (When a camera is maximized) -->
    <FrameLayout
        android:id="@+id/fullscreen_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <TextureView
            android:id="@+id/fullscreen_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Fullscreen Top-Left Badge -->
        <LinearLayout
            android:id="@+id/fullscreen_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="24dp"
            android:background="@drawable/pill_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fs_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="HD"
                android:textColor="@color/focus_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fs_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="Camera 1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fullscreen Bottom Hint -->
        <TextView
            android:id="@+id/fullscreen_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/pill_badge"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:text="@string/hint_fullscreen"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </FrameLayout>

</FrameLayout>
